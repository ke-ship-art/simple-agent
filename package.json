{
  "name": "simple-agent",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "description": "中文本地文件智能体",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "prepare:assets": "node scripts/copy-pdf-assets.mjs",
    "dev": "npm run prepare:assets && electron-vite dev",
    "build": "npm run prepare:assets && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run typecheck && npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@monaco-editor/react": "^4.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "0.9.12",
    "diff": "^8.0.2",
    "fflate": "0.8.3",
    "monaco-editor": "^0.55.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "local.simpleagent.desktop",
    "productName": "Simple Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "Simple-Agent-${version}-win-${arch}.${ext}"
  }
}
